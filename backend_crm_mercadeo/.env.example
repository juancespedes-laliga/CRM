SCSE_DB_USER=your_user
SCSE_DB_PASSWD=your_password
SCSE_DB_IP=localhost
SCSE_DB_PORT=1521
SCSE_DB_DATABASE=your_service_name

# Obligatorio: debe ser el mismo SECRET_KEY/ALGORITHM del backend Login/SSO,
# para poder validar los tokens JWT que ese backend emite. Pide el valor real
# a quien administra el SSO - no generes uno nuevo aqui, no es un secreto
# propio de este backend.
SECRET_KEY=PIDE_EL_VALOR_REAL_A_QUIEN_ADMINISTRA_EL_SSO
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Envio de correo (Gmail). SMTP_PASSWORD es la "contrasena de aplicacion" de 16
# caracteres (myaccount.google.com/security -> Verificacion en dos pasos ->
# Contrasenas de aplicaciones), NO la contrasena normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=CRM Mercadeo LaLiga

# MailerTurbo (correo masivo). Credenciales del Web Service que entrega MailerTurbo.
MAILERTURBO_URL=https://mailerturbo.com/apiserver
MAILERTURBO_USUARIO=
MAILERTURBO_CLAVE=
MAILERTURBO_LLAVE=
MAILERTURBO_IDEMPRESA=
# Opcional: usuario (afiliado) de la plataforma, para abrir MailerTurbo ya logueado.
MAILERTURBO_AFILIADO_NICK=
MAILERTURBO_AFILIADO_CLAVE=
